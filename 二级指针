#define _CRT_SECURE_NO_WARNINGS 1
#include<stdio.h>
#include<stdlib.h>
#include<string.h>

int sum_num(char*a)
{
	int sum = 0;
	for (int i = 0;a[i] != '\0'; i++)
		sum += (a[i]-'0');
	return sum;
}

int main()
{
	int n;
	scanf("%d", &n);
	char** a = malloc(sizeof(char*) * n);
	if (a == 0)return 0;
	int sum_NUM=0;
	for (int i = 0; i < n; i++)
	{
		a[i] = malloc(sizeof(char) * 101);
		scanf("%s", a[i]);
		sum_NUM += sum_num(a[i]);
	}

	int nature = sum_NUM % 3;

	if (nature == 0)
		printf("YES");
	else
		printf("NO");

	for (int i = 0; i < n; i++)
	{
		free(a[i]);
		a[i] = NULL;
	}

	free(a);
	a = NULL;

	return 0;
}
